# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Only for scripts/db-migrate.sh and db-reset.sh: Supabase → Connect → Session pooler URI. Not needed on Vercel.
SUPABASE_DB_URL=''

# Password for the whole app (login once, remembered for 400 days).
# Required in production: without it every page answers 503.
APP_PASSWORD=

# AI filter tab (platform.openai.com → API keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# reasoning effort per job: none | low | medium | high (dropped automatically if the model doesn't support it)
OPENAI_ASSESS_EFFORT=high
OPENAI_DEDUP_EFFORT=low
# optional: a different model per job (default OPENAI_MODEL)
OPENAI_ASSESS_MODEL=
OPENAI_DEDUP_MODEL=
# optional, for a proxy / Azure-compatible endpoint (default https://api.openai.com/v1)
OPENAI_BASE_URL=

# Scraping (Settings tab). Telegram: @BotFather -> /mybots -> your bot -> API Token, and your chat id
# (the chatId in Node-RED's flush_queue node). Without them offers are still saved, just not sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional: the secret for /api/cron/scrape (default: derived from APP_PASSWORD). Vercel Cron sends
# this one by itself, if you use it (Pro plan only for more than once a day).
CRON_SECRET=
