# The database (the app, and npm run db:migrate): Supabase → Connect → Connection string, with
# [YOUR-PASSWORD] replaced by the database password. Server-side only, never NEXT_PUBLIC_.
#   the Session pooler URI (port 5432), here and on Vercel alike. Not the Transaction pooler (6543):
#   the app's pages hang through it (lib/db/client.ts)
SUPABASE_DB_URL=

# Password for the whole app (login once, remembered for 400 days).
# Required in production: without it every page answers 503.
APP_PASSWORD=

# AI filter tab (platform.openai.com → API keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# reasoning effort per job: none | low | medium | high (dropped automatically if the model doesn't support it)
OPENAI_ASSESS_EFFORT=high
OPENAI_DEDUP_EFFORT=low
# optional: a different model per job (default OPENAI_MODEL); EXTRACT = "Add application" reading a page
OPENAI_ASSESS_MODEL=
OPENAI_DEDUP_MODEL=
OPENAI_EXTRACT_MODEL=
OPENAI_EXTRACT_EFFORT=low
# optional, for a proxy / Azure-compatible endpoint (default https://api.openai.com/v1)
OPENAI_BASE_URL=

# Scraping (Settings tab). Telegram: @BotFather -> /mybots -> your bot -> API Token, and your chat id
# (write to the bot, then copy message.chat.id from api.telegram.org/bot<token>/getUpdates; a group's
# starts with -). Without them offers are still saved, just not sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional: another Bot API server, e.g. a local one (default https://api.telegram.org)
TELEGRAM_API_URL=
# optional: push notifications on your phone (Settings -> Notifications). Without all three, push is off.
# The keys: npx web-push generate-vapid-keys (public and private, base64url); keep the private one secret.
# The subject is how the push services can reach you: mailto:you@example.com (or an https:// URL).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# optional: the secret Supabase Cron sends to /api/cron/scrape (default: derived from APP_PASSWORD)
CRON_SECRET=

# Set by Vercel itself (the production domain): links in Telegram, and the address Supabase Cron and the
# Telegram webhook are given. Locally the request's own address is used.
# VERCEL_PROJECT_PRODUCTION_URL=
